# Ignore everything by default
*

# But track these specific directories and their contents
!/.gitignore
!/.gitmodules
!/README.md
!/tmux/
!/tmux/**
!/tmux-sessionizer/
!/tmux-sessionizer/**
!/hypr/
!/hypr/**
!/kitty/
!/kitty/**
!/nvim/
!/nvim/**
!/waybar/
!/waybar/**
!/wofi/
!/wofi/**
!/zsh/
!/zsh/**

# Machine-specific; never tracked
/zsh/local.zsh
