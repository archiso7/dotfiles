# Ignore everything by default
*

# But track these specific directories and their contents
!/.gitignore
!/.gitmodules
!/README.md
!/bin/
!/bin/**
!/profiles/
!/profiles/**
!/windows/
!/windows/**
!/tmux/
!/tmux/**
!/tmux-sessionizer/
!/tmux-sessionizer/**
!/hypr/
!/hypr/**
!/kitty/
!/kitty/**
!/nvim/
!/nvim/**
!/waybar/
!/waybar/**
!/wofi/
!/wofi/**
!/zsh/
!/zsh/**

# Machine-specific; never tracked
/zsh/local.zsh
/tmux/local.conf
/windows/local.ps1

# Generated by ~/.config/rice/apply-theme.sh; tracked equivalents live in
# tmux/theme/*.conf
/tmux/theme.conf
